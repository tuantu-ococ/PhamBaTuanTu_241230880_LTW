@model HangHoa
@{
    ViewData["Title"] = "Thêm hàng hóa mới";
}
<div>Pham Ba Tuan Tu</div>
<div> Them hang hoa moi</div>

<form asp-action="Create" method="post" >
    <div class="form-group">
        <label asp-for="MaLoai"></label>
        <select asp-for="MaLoai" class="form-control" asp-items="@ViewBag.MaLoai"></select>
        <span asp-validation-for="MaLoai" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="TenHang"></label>
        <input asp-for="TenHang" class="form-control" />
        <span asp-validation-for="TenHang" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Gia"></label>
        <input asp-for="Gia" class="form-control" />
        <span asp-validation-for="Gia" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Anh"></label>
        <input type="file" asp-for="Anh" class="form-control-file" />
        <span asp-validation-for="Anh" class="text-danger"></span>
    </div>
    <div><input type="submit" value="Create" /></div>
</form>
